* text=auto

# Keep model, terrain and image bytes identical on Windows and other platforms.
*.bin binary
*.glb binary
*.gltf text
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gz binary
*.br binary
*.zip binary
# This generated manifest is pinned by byte digest in the Worker.
public/region/terrain.json text eol=lf
public/field/vectors-*.json text eol=lf
