/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: xr-spatial-tracking=(self), camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://cyberjapandata.gsi.go.jp; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
/city/*
  Cache-Control: public, max-age=3600
/region/*
  Cache-Control: public, max-age=3600
